{
  "source": {
    "project": "ggml-org/llama.cpp",
    "file": "tools/server/README.md",
    "url": "https://raw.githubusercontent.com/ggml-org/llama.cpp/master/tools/server/README.md",
    "pinned_at": "2026-10-05",
    "note": "Endpoint headings extracted verbatim from the pinned README. scripts/validate.py --phase=inventory enforces every entry below: blazar_route must be a mounted route in crates/blazar-gateway/src/lib.rs, or a non-empty exemption reason must be recorded. Re-pin by re-fetching the README, updating pinned_at, and reconciling drift."
  },
  "endpoints": [
    {"method": "GET",  "upstream_path": "/health",                            "blazar_route": "/health"},
    {"method": "POST", "upstream_path": "/completion",                        "blazar_route": "/completion"},
    {"method": "POST", "upstream_path": "/tokenize",                          "blazar_route": "/tokenize"},
    {"method": "POST", "upstream_path": "/detokenize",                        "blazar_route": "/detokenize"},
    {"method": "POST", "upstream_path": "/apply-template",                    "blazar_route": "/apply-template"},
    {"method": "POST", "upstream_path": "/embedding",                         "exemption": "legacy deprecated alias upstream; the /v1/embeddings dialect is the served surface on this gateway"},
    {"method": "POST", "upstream_path": "/reranking",                         "blazar_route": "/v1/rerank", "aliases": ["/v1/reranking"]},
    {"method": "POST", "upstream_path": "/infill",                            "blazar_route": "/infill"},
    {"method": "GET",  "upstream_path": "/props",                             "blazar_route": "/props"},
    {"method": "POST", "upstream_path": "/props",                             "blazar_route": "/props"},
    {"method": "POST", "upstream_path": "/embeddings",                        "blazar_route": "/embeddings"},
    {"method": "GET",  "upstream_path": "/slots",                             "blazar_route": "/slots"},
    {"method": "GET",  "upstream_path": "/metrics",                           "blazar_route": "/metrics", "note": "blazar's own Prometheus exposition; child --metrics flag is wired by the engine profile"},
    {"method": "POST", "upstream_path": "/slots/{id_slot}?action=save",       "blazar_route": "/slots/{id}", "note": "action passed through the forwarded query string (save/restore/erase)"},
    {"method": "POST", "upstream_path": "/slots/{id_slot}?action=restore",    "blazar_route": "/slots/{id}"},
    {"method": "POST", "upstream_path": "/slots/{id_slot}?action=erase",      "blazar_route": "/slots/{id}"},
    {"method": "GET",  "upstream_path": "/lora-adapters",                     "blazar_route": "/v1/adapters", "note": "translated dialect path; same handler, same semantics"},
    {"method": "POST", "upstream_path": "/lora-adapters",                     "blazar_route": "/v1/adapters"},
    {"method": "GET",  "upstream_path": "/v1/models",                         "blazar_route": "/v1/models"},
    {"method": "POST", "upstream_path": "/v1/completions",                    "blazar_route": "/v1/completions"},
    {"method": "POST", "upstream_path": "/v1/chat/completions",               "blazar_route": "/v1/chat/completions"},
    {"method": "POST", "upstream_path": "/v1/chat/completions/control",       "blazar_route": "/v1/chat/completions/control"},
    {"method": "POST", "upstream_path": "/v1/responses",                      "blazar_route": "/v1/responses"},
    {"method": "POST", "upstream_path": "/v1/embeddings",                     "blazar_route": "/v1/embeddings"},
    {"method": "POST", "upstream_path": "/v1/responses/input_tokens",         "blazar_route": "/v1/responses/input_tokens"},
    {"method": "POST", "upstream_path": "/v1/chat/completions/input_tokens",  "blazar_route": "/v1/chat/completions/input_tokens"},
    {"method": "POST", "upstream_path": "/v1/messages",                       "blazar_route": "/v1/messages", "note": "translated dialect (F52: the messages lane translates and refuses passthrough)"},
    {"method": "POST", "upstream_path": "/v1/messages/count_tokens",          "blazar_route": "/v1/messages/count_tokens"},
    {"method": "POST", "upstream_path": "/v1/systemone",                      "blazar_route": "/v1/systemone"},
    {"method": "GET",  "upstream_path": "/models",                            "exemption": "router-mode model cache listing; blazar owns model lifecycle (GET /api/tags, /api/ps)"},
    {"method": "POST", "upstream_path": "/models/load",                       "exemption": "router-mode model load; blazar's supervisor/engine-manager owns child lifecycle"},
    {"method": "POST", "upstream_path": "/models/unload",                     "exemption": "router-mode model unload; blazar's supervisor owns child lifecycle (POST /api/evict, idle reaper)"},
    {"method": "GET",  "upstream_path": "/models/sse",                        "exemption": "router-mode model event stream; blazar exposes /api/events and /api/watch on its own plane"},
    {"method": "POST", "upstream_path": "/models",                            "exemption": "router-mode model download; blazar serves POST /api/pull instead"},
    {"method": "DELETE", "upstream_path": "/models",                          "exemption": "router-mode cache delete; blazar serves POST /api/delete instead"},
    {"method": "GET",  "upstream_path": "/",                                  "exemption": "embedded upstream web UI; blazar serves its own console at GET /ui"}
  ]
}
