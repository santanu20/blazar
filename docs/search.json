---
layout: none
---
[
{% assign pages = site.html_pages | where_exp: "p", "p.url != '/search.html' and p.url != '/404.html'" %}
{% for page in pages %}
  {
    "title": {{ page.title | default: page.name | jsonify }},
    "url": {{ page.url | jsonify }},
    "text": {{ page.content | strip_html | strip_newlines | replace: "  ", " " | truncate: 8000 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
