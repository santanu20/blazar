{
  "name": "blazar-sdk",
  "version": "0.1.0",
  "description": "Zero-dependency TypeScript client for the blazar inference control plane",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/sse.test.ts",
    "test:live": "tsx --test tests/live.test.ts"
  },
  "keywords": [
    "blazar",
    "llm",
    "inference",
    "gateway",
    "local-ai"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0"
  }
}
